# ================================================================
# OccuSafe — Docker production environment
# Copy to .env next to docker-compose.yml and fill in every CHANGE_ME.
# ================================================================

# ---- Network ----
# LAN IP (or DNS name) of this server as seen by operators' browsers.
# Required for WebRTC live video. Comma-separate multiple values.
WEBRTC_PUBLIC_HOST=192.168.1.50
# Host port for the web UI + API
HTTP_PORT=80
# Bind address for the RTSP re-stream port 8554 (127.0.0.1 = local only, 0.0.0.0 = LAN)
RTSP_BIND=127.0.0.1

# ---- Secrets (generate fresh values, never reuse the examples) ----
# Only the first 32 characters are used.   openssl rand -base64 24
# Keep this identical to the old value if you migrate an existing cameras.db,
# otherwise stored camera passwords cannot be decrypted.
CAMERA_SECRET_KEY=CHANGE_ME_32_CHARACTER_SECRET_KEY
#                                        openssl rand -hex 48
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CORS (UI is served same-origin, only needed for extra origins) ----
CORS_ORIGINS=http://localhost

# ---- Camera health monitor ----
CAMERA_HEALTH_INTERVAL=60
CAMERA_RTSP_TIMEOUT=3.0
CAMERA_HEALTH_CONCURRENCY=4
CAMERA_FAILURE_THRESHOLD=2
CAMERA_MOCK_MODE=false

# ---- Stream sessions ----
STREAM_IDLE_TIMEOUT=15
STREAM_SESSION_TIMEOUT=60

# ---- AI inference ----
# auto = CUDA when available, else CPU. GPU override file sets cuda.
AI_DEVICE=auto
AI_USE_FP16=true
AI_DEFAULT_FPS=5
AI_DEFAULT_CONFIDENCE=0.45
AI_PHONE_CONFIDENCE=0.75
AI_COCO_PHONE_CONFIDENCE=0.70
AI_IMAGE_SIZE=640
AI_BATCH_SIZE=4
AI_MAX_FRAME_QUEUE=2
AI_CONFIRMATION_FRAMES=3
AI_COOLDOWN_SECONDS=10
AI_MAX_CAMERAS=64
AI_MOCK_MODE=false

# ---- Identity / attendance / retention ----
IDENTITY_CONFIRMATION_FRAMES=4
IDENTITY_MATCH_THRESHOLD=0.70
IDENTITY_REID_THRESHOLD=0.78
ATTENDANCE_ABSENCE_MINUTES=30
EVIDENCE_RETENTION_DAYS=90
