# ================================================================
# CCTV Priya Textiles - Camera Management Backend Environment Config
# ================================================================

PORT=5000

# SQLite Database path (local, privacy-first)
CAMERA_DB_PATH=./data/cameras.db

# 32-byte secret key for authenticated AES-GCM credential encryption
CAMERA_SECRET_KEY=CHANGE_ME_TO_A_SECURE_32_BYTE_SECRET_KEY!

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MediaMTX Configuration (Local WebRTC & RTSP streaming server)
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_API_PORT=9997
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_RTSP_PORT=8554

# Asynchronous Lightweight Camera Health Monitor (Every 60s / 1 minute)
CAMERA_HEALTH_INTERVAL=60
CAMERA_RTSP_TIMEOUT=3.0
CAMERA_HEALTH_CONCURRENCY=4
CAMERA_FAILURE_THRESHOLD=2

# Live Stream Viewer Session Management
STREAM_IDLE_TIMEOUT=15
STREAM_SESSION_TIMEOUT=60

# Optional Development / Test Mock Mode (true enables simulated camera reachability)
CAMERA_MOCK_MODE=false

# Continuous shared-model AI pipeline
AI_MODEL_PATH=./models/ppe.pt
AI_DEFAULT_FPS=5
AI_DEFAULT_CONFIDENCE=0.45
AI_IMAGE_SIZE=640
AI_DEVICE=auto
AI_USE_FP16=true
AI_BATCH_SIZE=4
AI_MAX_FRAME_QUEUE=2
AI_CONFIRMATION_FRAMES=3
AI_COOLDOWN_SECONDS=10
AI_MAX_CAMERAS=64
AI_MOCK_MODE=false
AI_EVIDENCE_DIR=./data/evidence

# Allowed CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
